# Copy to .env and fill in.  cp .env.example .env
# .env is gitignored and must NEVER be committed — it holds live credentials.

# ---------------------------------------------------------------- Gmail
# OAuth client file downloaded from Google Cloud Console (Desktop app type).
# See SETUP.md step 1. Both of these are gitignored.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Only mail from these senders is ever acted on — everything else is ignored.
# This is the security boundary: without it, anyone who learns the mailbox
# address could create board items by putting "!addp" in a subject line.
# Comma-separated, no spaces.
INTAKE_ALLOWED_SENDERS=analyst@gmail.com
INTAKE_ALLOWED_DOMAINS=farklabs.com

# Optional but recommended on a busy inbox. Set this to a plus-alias and have
# the team forward there instead. Gmail delivers "you+anything@gmail.com" to
# the same mailbox with no setup, but the script then only ever sees mail sent
# to that alias — ordinary team mail is never fetched, examined or labelled.
#   INTAKE_TO_ADDRESS=youraddress+monday@gmail.com
INTAKE_TO_ADDRESS=

# How far back to look on each poll, and how often to poll in --watch mode.
INTAKE_LOOKBACK_DAYS=7
INTAKE_POLL_SECONDS=120

# If the script has been stopped, the next run widens its search to cover the
# downtime so nothing ages out of the window unseen. This caps how far back
# that catch-up will ever reach.
INTAKE_MAX_LOOKBACK_DAYS=90

# Remembers when the last pass finished, and which messages were handled.
# Deleting it is safe: the script falls back to INTAKE_LOOKBACK_DAYS and the
# Gmail labels still prevent anything being posted twice.
INTAKE_STATE_FILE=state.json

# Gmail labels used for bookkeeping (created automatically on first run).
INTAKE_LABEL_PREFIX=Monday

# ---------------------------------------------------------------- Monday
# Monday -> avatar (bottom left) -> Developers -> My access tokens.
MONDAY_API_TOKEN=
MONDAY_API_VERSION=2024-10

# --- !addp : startups -> deal pipeline ---------------------------------
# Board ids are the numbers in the Monday board URL; not secret.
MONDAY_DEAL_BOARD_ID=18146507025
MONDAY_DEAL_GROUP_ID=
# Run `python3 -m intake.cli inspect-board deal` to list the real column ids.
# Anything left blank is skipped; with none set you still get items + updates.
MONDAY_DEAL_COL_EMAIL=
MONDAY_DEAL_COL_WEBSITE=
MONDAY_DEAL_COL_CONTACT=
MONDAY_DEAL_COL_PHONE=
MONDAY_DEAL_COL_INTAKE_DATE=
MONDAY_DEAL_COL_NOTES=
# Every real document on a startup forward (deck, one-pager) is uploaded here
# as a file, in addition to staying in the activity-feed comments.
MONDAY_DEAL_COL_PITCH_DECK=file_mkwj6ztn

# --- !addi : investor leads -> investor board --------------------------
MONDAY_INVESTOR_BOARD_ID=18146373310
MONDAY_INVESTOR_GROUP_ID=
# Run `python3 -m intake.cli inspect-board investor` to list the real ids.
MONDAY_INVESTOR_COL_EMAIL=
MONDAY_INVESTOR_COL_WEBSITE=
MONDAY_INVESTOR_COL_CONTACT=
MONDAY_INVESTOR_COL_PHONE=
MONDAY_INVESTOR_COL_INTAKE_DATE=
MONDAY_INVESTOR_COL_NOTES=
MONDAY_INVESTOR_COL_PITCH_DECK=

# --------------------------------------------------------------- Behaviour
# Reply to whoever forwarded the mail, confirming what happened. Keeps the
# sender in the loop and makes a wrong name obvious immediately.
REPLY_ON_SUCCESS=true
REPLY_ON_ERROR=true

UPLOAD_ATTACHMENTS=true
MAX_ATTACHMENT_MB=25
